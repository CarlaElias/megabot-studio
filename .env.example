# SQLite es suficiente para realizar pruebas locales. Para tres admins en Internet: usar MySQL
DATABASE_URL=sqlite:///./data/megabot.db
# DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/megabot
COOKIE_SECURE=0
# Al alojar detrás de HTTPS: COOKIE_SECURE=1 y configurar ALLOWED_ORIGIN
ALLOWED_ORIGIN=http://127.0.0.1:8000
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1.5
# Límite explícito de llamadas IA por lote, máximo permitido por solicitud
MAX_AI_IMAGES_PER_JOB=50
TEXT_MODEL=gpt-4.1-mini
# Para avisos push con página cerrada, tras desplegar bajo HTTPS:
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:tu-email@dominio.com
# Si MegaBot no tiene administradores, habilita un código privado de configuración inicial.
MEGABOT_SETUP_TOKEN=
# Solo si deseas mostrar teléfono de contacto en cada anuncio local.
CONTACT_WHATSAPP=
